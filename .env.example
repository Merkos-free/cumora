# Cumora — пример переменных окружения
#
# Скопируйте файл в `.env` (он уже добавлен в .gitignore) и укажите реальные
# значения для локальной разработки или своего сервера. Обязательные параметры
# отмечены отдельно; для остальных в server/src/env.ts предусмотрены разумные
# значения по умолчанию.
#
# При запуске через `npm run server:dev` или `tsx server/...` можно:
#   - хранить настройки в `.env` в корне репозитория и подключить dotenv-loader;
#   - либо экспортировать переменные в терминале перед запуском сервера.
#
# В примерах ниже используются нейтральные домены example.ru. Замените их на
# свои адреса. Русский форк не должен подключаться к api.cumora.ai, app.cumora.ai
# или другим production-сервисам оригинального проекта без явного решения
# владельца такого сервиса.

# ─── Основные настройки ──────────────────────────────────────────────────
# Порт API- и WebSocket-сервера. По умолчанию: 5181.
PORT=5181
NODE_ENV=development

# Строка подключения к PostgreSQL.
# По умолчанию: `postgres://<текущий-пользователь>@localhost:5432/cumora`.
# DATABASE_URL=postgres://cumora@localhost:5432/cumora

# Redis Pub/Sub для WebSocket-моста и планировщика агентов.
# REDIS_URL=redis://localhost:6379

# ─── OpenAI (обязательно для стандартного облачного режима) ──────────────
# Используется для основных ходов агентов, классификаторов и генерации
# изображений. При полностью локальном BYOA-наборе требования зависят от того,
# какие серверные функции вы включили.
OPENAI_API_KEY=sk-...

# Переопределение моделей — необязательно. Cumora делит вызовы LLM на уровни:
#   - «основная модель» (OPENAI_MODEL): главные ходы агентов и выступления на
#     совещаниях. Здесь качество сильнее всего влияет на результат продукта;
#   - «быстрая модель» (OPENAI_MODEL_SUPPORT): JSON-классификаторы, палитра,
#     выбор параметров портрета и первичная проверка повестки. Здесь важнее
#     скорость и стоимость;
#   - «модель-суммаризатор» (OPENAI_COMPACTION_MODEL): сжатие длинного
#     контекста, проверка завершения хода и сводка новых указаний во время
#     работы. По умолчанию относится к тому же уровню, что SUPPORT, но её можно
#     отдельно направить на модель с большим контекстом.
# Оставьте пустым, чтобы использовать системные значения из env.ts.
# OPENAI_MODEL=gpt-5.5
# OPENAI_MODEL_SUPPORT=gpt-5.4-mini
# OPENAI_COMPACTION_MODEL=gpt-5.4-mini
# OPENAI_IMAGE_MODEL=gpt-image-2

# ─── OrcaRouter (необязательно) ──────────────────────────────────────────
# OpenAI-совместимый шлюз: https://www.orcarouter.ai
# Агент выбирает его префиксом `orcarouter/`, например:
# `orcarouter/openai/gpt-4o-mini`.
# OrcaRouter напрямую поддерживает Responses API, поэтому здесь меняется только
# базовый URL. Если ключ не задан, модели `orcarouter/*` откатываются на
# старый клиент / sub2api согласно серверной конфигурации.
# ORCAROUTER_API_KEY=sk-orca-...
# ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1

# ─── Tavily (необязательно) ──────────────────────────────────────────────
# Используется инструментом агента `web.search`. Без ключа веб-поиск отключён.
# TAVILY_API_KEY=

# ─── Планировщики ────────────────────────────────────────────────────────
# Интервал фонового аудита бренда агентом Люмен, миллисекунды.
# ENABLE_SCANNER=false полностью отключает сканер.
# SCANNER_INTERVAL_MS=90000

# Планировщик простоя. На каждом шаге он выбирает одного тихого агента и
# проверяет его карточки канбана и события текущего временного окна. Быстрая
# модель решает, стоит ли будить основную: при полезном сигнале создаётся
# краткое задание, иначе запуск пропускается без дорогого вызова. Если повестки
# нет, агент может перейти к штатному сценарию инициативного сообщения.
# Значение 0 или ENABLE_IDLE=false отключает планировщик.
# IDLE_INTERVAL_MS=900000
# IDLE_MIN_QUIET_MIN=25

# ─── Публичный адрес для vision в локальной разработке ───────────────────
# input_image загружает изображение со стороны провайдера модели, поэтому
# localhost ему недоступен. Для локального дискового хранилища направьте сюда
# туннель ngrok/cloudflared до порта 5181. В режиме R2 эта настройка не нужна:
# URL файлов уже публично достижимы.
# PUBLIC_HOST=https://cumora-dev.example.ru

# ─── Cloudflare R2 / S3-совместимое объектное хранилище ──────────────────
# Когда заданы все четыре основные переменные R2_, слой хранения переходит в
# режим R2:
#   - браузер загружает файлы напрямую по подписанному PUT-адресу;
#   - созданные аватары сохраняются в R2;
#   - статическая раздача server/uploads/ отключается.
# Если хотя бы одно обязательное значение пустое, сервер хранит файлы локально.

# Endpoint бакета. Для R2:
# `https://<account-id>.r2.cloudflarestorage.com`.
# Account ID: Cloudflare Dashboard → R2 → Use R2 with APIs.
R2_ENDPOINT=

# Имя уже созданного бакета.
R2_BUCKET=

# Ключи с правами чтения и записи объектов. В Cloudflare:
# R2 → Manage R2 API Tokens → Create API token → Object Read & Write,
# ограничив доступ только нужным бакетом.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Публичная база чтения: ваш CDN/домен либо r2.dev-адрес бакета.
# При заданном значении ссылки стабильны и кешируются: `<base>/<key>`.
# Если оставить пустым, сервер будет создавать короткоживущие подписанные GET-
# ссылки. Чат продолжит работать, но URL будут меняться и хуже кешироваться.
# R2_PUBLIC_BASE=https://cdn.example.ru
R2_PUBLIC_BASE=

# Общий HMAC-секрет сервера и Worker `cumora-r2-gate` (workers/r2-gate).
# Когда он задан, публичные ссылки получают `?exp&sig`, а Worker проверяет
# подпись до чтения объекта. Создание: `openssl rand -hex 32`.
# Точно такое же значение передайте Worker:
# `cd workers/r2-gate && npx wrangler secret put R2_URL_SIGNING_SECRET`.
# Пустой секрет допустим только в локальной разработке.
R2_URL_SIGNING_SECRET=

# Срок действия подписанной ссылки в секундах. По умолчанию один час.
# При каждом чтении ссылка подписывается заново.
# R2_URL_TTL_SECONDS=3600

# ─── OAuth и адреса возврата после входа ─────────────────────────────────
# Учётные данные провайдеров. Пустая пара отключает соответствующий маршрут
# `/auth/start/<provider>` — сервер вернёт 503.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=

# GitLab для авторизации. По умолчанию используется gitlab.com; для своего
# GitLab укажите его базовый адрес. Redirect URI в настройках приложения:
# `<CUMORA_PUBLIC_ORIGIN>/api/auth/callback/gitlab`, scope `read_user`.
# Этот сервер считается доверенным источником подтверждённой почты — так же,
# как Google и GitHub. По проверенному адресу Cumora связывает вход с уже
# существующим аккаунтом.
# GITLAB_BASE_URL=https://gitlab.com

# Публично доступный origin ЭТОГО API-сервера. Он используется в redirect_uri,
# который передаётся OAuth-провайдерам. Для разработки можно указать туннель,
# для production — собственный HTTPS-домен API.
# CUMORA_PUBLIC_ORIGIN=https://api.example.ru

# Куда OAuth callback перенаправляет браузер после создания сессии. В fragment
# добавляются `#token=...&companyId=...`. Значение используется, если клиент не
# передал `?return=`. В production укажите адрес своего SPA.
# CUMORA_AUTH_DONE_URL=https://app.example.ru/

# Разрешённые префиксы `?return=` через запятую. Это защита от open redirect.
# Добавьте все домены своего SPA и админки, локальные адреса Electron/Vite и
# deep-link. Не добавляйте широкие или чужие домены без необходимости.
# CUMORA_AUTH_RETURN_ALLOWLIST=https://app.example.ru/,https://admin.example.ru/,http://localhost:5180/,http://localhost:5173/,http://127.0.0.1:47823/auth/done,cumora://auth

# База для ссылок принятия приглашений: `<base>/invite/<token>`.
# По умолчанию берётся CUMORA_AUTH_DONE_URL. Указывайте отдельно только тогда,
# когда экран приглашения размещён на другом origin.
# CUMORA_INVITE_BASE_URL=https://app.example.ru

# Разрешённые CORS-origin через запятую. При same-origin-развёртывании, где SPA
# отдаётся тем же backend, переменная не нужна. Она требуется, если отдельно
# размещённый веб-клиент или Electron обращается к API с другого origin.
# CUMORA_CORS_ORIGINS=https://app.example.ru,https://admin.example.ru

# ─── Продуктовая аналитика (необязательно) ───────────────────────────────
# PostHog запускается только при заданном VITE_PUBLIC_POSTHOG_KEY.
# Эти значения встраиваются Vite в клиентский bundle, поэтому Docker- и
# desktop-сборка должны получить их ДО `npm run build`.
# События не должны содержать тексты сообщений, документов или секреты.
# VITE_PUBLIC_POSTHOG_KEY=phc_xxxxxxxx
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── SkillHub — каталог навыков агентов (необязательно) ──────────────────
# Базовый URL совместимого каталога. Агенты обращаются к нему командами:
# `cumora skills search <запрос>` и `cumora skills install <id>`.
# Ожидаемый контракт:
#   GET <hub>/search?q=<query>
#     → [{ name, description, version?, author?, install_url? }]
#   GET <hub>/skills/<name>  (либо явный install_url)
#     → { name, description, version?, author?, files: [{ path, body }, …] }
# Если оставить пустым, поиск и установка из каталога отключаются. Создавать
# собственные локальные навыки через `cumora skills create` всё равно можно.
# SKILLHUB_URL=https://skills.example.ru
SKILLHUB_URL=

# ─── Настоящая внешняя почта для агентов ─────────────────────────────────
# Когда заданы все три значения, агенты могут отправлять и принимать письма.
# Исходящие идут через HTTP API Resend. Входящие принимает Cloudflare Email
# Worker из workers/email-gate и отправляет разобранный JSON на
# `/webhooks/email/inbound`, подписывая его EMAIL_INBOUND_HMAC_SECRET.
#
# Адрес агента: `<participantId>.<companySlug>@<EMAIL_DOMAIN>`, например
# `atlas.acme@mail.example.ru`. Все пространства используют один заранее
# подтверждённый домен, поэтому DKIM/SPF настраиваются один раз.
#
# Пустой RESEND_API_KEY включает mock-режим: `cumora email send` возвращает
# тестовый message-id и пишет событие в журнал, не обращаясь в Resend. Это
# удобно локально. Входящая почта отдельно защищается HMAC-секретом.
#
# Настройка:
#   1. В Resend создайте API-ключ и добавьте SPF/DKIM-записи для EMAIL_DOMAIN.
#   2. В Cloudflare включите Email Routing и разверните workers/email-gate как
#      catch-all для *@<EMAIL_DOMAIN>.
#   3. Подробности находятся в docs/email.md.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_DOMAIN=mail.example.ru
# EMAIL_INBOUND_HMAC_SECRET=<случайная строка 32 байта в hex/base64>
RESEND_API_KEY=
EMAIL_DOMAIN=
EMAIL_INBOUND_HMAC_SECRET=
